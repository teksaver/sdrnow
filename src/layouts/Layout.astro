---
import '../styles/emphasis.css';

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
  alternateHref?: string;
  alternateLang?: string;
  titleKey?: string;
}

const {
  title,
  description,
  lang = 'fr',
  alternateHref,
  alternateLang,
  titleKey = 'meta.title',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://sdrnow.fr').href;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title data-i18n={titleKey}>{title}</title>
  <meta name="description" content={description} data-i18n-content="meta.description" />
  <link rel="canonical" href={canonicalUrl} />
  {alternateHref && alternateLang && (
    <link rel="alternate" hreflang={alternateLang} href={new URL(alternateHref, 'https://sdrnow.fr').href} />
  )}
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet" />
</head>
<body class="antialiased text-text_main bg-background font-sans leading-relaxed">
  <slot />
  <!-- First-party cookieless beacon (CAP-4, conventions §3), hand-minified to stay < 1.5 KB: POST /health events only, nothing stored on the device. ping.d = visible seconds since the previous ping, sent every 60 s while visible to keep the alert debounce alive. -->
  <script is:inline>(function(){var d=document,n=navigator,p=location.pathname,a=0,v=d.visibilityState=='visible'?Date.now():0;function S(e,t,x){try{var b=JSON.stringify({e:e,p:p,d:x||0,t:t||''});n.sendBeacon&&n.sendBeacon('/health',b)||fetch('/health',{method:'POST',body:b,keepalive:!0})}catch(_){}}function F(){v&&(a+=Date.now()-v,v=d.visibilityState=='visible'?Date.now():0);var s=Math.round(a/1e3);s>0&&(a=0,S('ping','',s))}function C(e){var l=e&&e.closest&&e.closest('a[href^="tel:"],a[href^="mailto:"]');return l?l.getAttribute('href').indexOf('tel:')?'email':'phone':''}S('init');d.addEventListener('visibilitychange',function(){d.visibilityState=='visible'?v=Date.now():F()});addEventListener('pagehide',F);setInterval(F,6e4);addEventListener('beforeprint',function(){S('print')});var P=d.querySelector('[data-track=pricing]');if(P&&window.IntersectionObserver){var o=new IntersectionObserver(function(l){l.some(function(x){return x.isIntersecting})&&(o.disconnect(),S('pricing_view'))});o.observe(P)}d.addEventListener('copy',function(){var s=getSelection(),e=s&&s.anchorNode;e=e&&e.nodeType==3?e.parentNode:e;if(!e||!e.closest)return;var k=e.closest('[data-plan]'),t=k?k.getAttribute('data-plan'):e.closest('[data-track=pricing]')?'pricing':C(e);t&&S('copy',t)});d.addEventListener('click',function(x){var l=x.target.closest&&x.target.closest('a');if(!l)return;var g=l.getAttribute('data-lang-switch');g?g!=d.documentElement.lang&&S('lang_switch',g):C(l)&&S('contact',C(l))},!0)})();</script>
</body>
</html>
