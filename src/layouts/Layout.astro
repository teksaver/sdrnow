---
interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
  alternateHref?: string;
  alternateLang?: string;
}

const {
  title,
  description,
  lang = 'fr',
  alternateHref,
  alternateLang,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://sdrnow.fr').href;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {alternateHref && alternateLang && (
    <link rel="alternate" hreflang={alternateLang} href={new URL(alternateHref, 'https://sdrnow.fr').href} />
  )}
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet" />
</head>
<body class="antialiased text-text_main bg-background font-sans leading-relaxed">
  <slot />
</body>
</html>
