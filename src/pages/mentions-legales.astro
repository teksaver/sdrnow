---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/translations';

const t = useTranslations('fr');
---

<Layout
  title={t('meta.legal_title')}
  description={t('meta.description')}
  lang="fr"
  alternateHref="/en/legal-notice"
  alternateLang="en"
  titleKey="meta.legal_title"
>
  <div class="flex flex-col min-h-screen">
    <header class="w-full bg-surface border-b border-border py-6 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto flex justify-between items-center">
        <a href="/" class="inline-block">
          <img src="/assets/logo.svg" alt="SDRnow" class="h-8 w-auto" />
        </a>
        <div class="flex items-center space-x-6">
          <a href="/" class="text-text_muted hover:text-text_main font-medium" data-i18n="nav.back_home" data-i18n-type="plain">{t('nav.back_home')}</a>
          <div class="inline-flex items-center space-x-1 text-xs font-semibold bg-white border border-border rounded-full p-1 shadow-sm">
            <a href="/mentions-legales" class="px-3 py-1 rounded-full bg-primary text-white">FR</a>
            <a href="/en/legal-notice" class="px-3 py-1 rounded-full text-text_muted hover:text-text_main">EN</a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-3xl font-bold mb-8 [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.title" data-i18n-type="rich" set:html={t('legal.title')}></h1>
        
        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4 [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.s1_title" data-i18n-type="rich" set:html={t('legal.s1_title')}></h2>
          <p class="text-text_muted mb-2 [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.s1_intro" data-i18n-type="rich" set:html={t('legal.s1_intro')}></p>
          <ul class="text-text_muted list-disc list-inside">
            <li><span data-i18n="legal.s1_company" data-i18n-type="plain">{t('legal.s1_company')}</span></li>
            <li><span data-i18n="legal.s1_email" data-i18n-type="plain">{t('legal.s1_email')}</span><a href="mailto:jcm@sdrnow.fr" class="text-primary hover:underline">jcm@sdrnow.fr</a></li>
            <li><span data-i18n="legal.s1_director" data-i18n-type="plain">{t('legal.s1_director')}</span></li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4 [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.s2_title" data-i18n-type="rich" set:html={t('legal.s2_title')}></h2>
          <p class="text-text_muted mb-2 [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.s2_intro" data-i18n-type="rich" set:html={t('legal.s2_intro')}></p>
          <ul class="text-text_muted list-disc list-inside">
            <li><span data-i18n="legal.s2_company" data-i18n-type="plain">{t('legal.s2_company')}</span></li>
            <li><span data-i18n="legal.s2_address" data-i18n-type="plain">{t('legal.s2_address')}</span></li>
            <li><span data-i18n="legal.s2_website" data-i18n-type="plain">{t('legal.s2_website')}</span><a href="https://www.scaleway.com" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">www.scaleway.com</a></li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4 [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.s3_title" data-i18n-type="rich" set:html={t('legal.s3_title')}></h2>
          <p class="text-text_muted [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.s3_text" data-i18n-type="rich" set:html={t('legal.s3_text')}></p>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4 [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.s4_title" data-i18n-type="rich" set:html={t('legal.s4_title')}></h2>
          <p class="text-text_muted [&_em]:text-primary [&_em]:not-italic [&_strong]:font-bold" data-i18n="legal.s4_text" data-i18n-type="rich" set:html={t('legal.s4_text')}></p>
        </section>
      </div>
    </main>

    <footer class="py-8 px-4 border-t border-border bg-surface text-center">
      <div class="max-w-4xl mx-auto">
        <p class="text-text_muted text-sm"><span data-i18n="footer.rights" data-i18n-type="plain">{t('footer.rights')}</span></p>
      </div>
    </footer>
  </div>
</Layout>
