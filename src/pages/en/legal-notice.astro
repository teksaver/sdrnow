---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/translations';

const t = useTranslations('en');
---

<Layout
  title={t('meta.legal_title')}
  description={t('meta.description')}
  lang="en"
  alternateHref="/mentions-legales"
  alternateLang="fr"
>
  <div class="flex flex-col min-h-screen">
    <header class="w-full bg-surface border-b border-border py-6 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto flex justify-between items-center">
        <a href="/en" class="text-2xl font-bold text-primary hover:text-orange-600 transition-colors">SDRnow</a>
        <div class="flex items-center space-x-6">
          <a href="/en" class="text-text_muted hover:text-text_main font-medium">{t('nav.back_home')}</a>
          <div class="inline-flex items-center space-x-1 text-xs font-semibold bg-white border border-border rounded-full p-1 shadow-sm">
            <a href="/mentions-legales" class="px-3 py-1 rounded-full text-text_muted hover:text-text_main">FR</a>
            <a href="/en/legal-notice" class="px-3 py-1 rounded-full bg-primary text-white">EN</a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-3xl font-bold mb-8">{t('legal.title')}</h1>
        
        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4">{t('legal.s1_title')}</h2>
          <p class="text-text_muted mb-2" set:html={t('legal.s1_intro')}></p>
          <ul class="text-text_muted list-disc list-inside">
            <li>{t('legal.s1_company')}</li>
            <li>{t('legal.s1_email')}<a href="mailto:jcm@sdrnow.fr" class="text-primary hover:underline">jcm@sdrnow.fr</a></li>
            <li>{t('legal.s1_director')}</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4">{t('legal.s2_title')}</h2>
          <p class="text-text_muted mb-2">{t('legal.s2_intro')}</p>
          <ul class="text-text_muted list-disc list-inside">
            <li>{t('legal.s2_company')}</li>
            <li>{t('legal.s2_address')}</li>
            <li>{t('legal.s2_website')}<a href="https://www.scaleway.com" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">www.scaleway.com</a></li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4">{t('legal.s3_title')}</h2>
          <p class="text-text_muted">{t('legal.s3_text')}</p>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4">{t('legal.s4_title')}</h2>
          <p class="text-text_muted">{t('legal.s4_text')}</p>
        </section>
      </div>
    </main>

    <footer class="py-8 px-4 border-t border-border bg-surface text-center">
      <div class="max-w-4xl mx-auto">
        <p class="text-text_muted text-sm">{t('footer.rights')}</p>
      </div>
    </footer>
  </div>
</Layout>
