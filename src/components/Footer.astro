---
import { useTranslations } from '../i18n/translations';

interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const phoneHref = lang === 'fr' ? 'tel:0667902494' : 'tel:+33667902494';
const legalHref = lang === 'fr' ? '/mentions-legales' : '/en/legal-notice';
---

<footer class="py-12 px-4 border-t border-border bg-background text-center">
  <div class="max-w-4xl mx-auto flex flex-col items-center">
    <a href={lang === 'fr' ? '/' : '/en'} class="inline-block mb-6">
      <img src="/assets/logo.svg" alt="SDRnow" class="h-8 w-auto" />
    </a>
    <div class="text-text_muted text-sm space-y-2">
      <p>
        <a href={phoneHref} class="hover:text-text_main">
          <span data-i18n="footer.phone" data-i18n-type="plain">{t('footer.phone')}</span>
        </a>
      </p>
      <p>
        <span data-i18n="footer.rights" data-i18n-type="plain">{t('footer.rights')}</span>{' '}
        <a href={legalHref} class="underline hover:text-text_main">
          <span data-i18n="footer.legal" data-i18n-type="plain">{t('footer.legal')}</span>
        </a>
      </p>
    </div>
  </div>
</footer>
